# Public Web OAuth client ID, shared with EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
# No client secret is used by native Google ID-token authentication.
GOOGLE_SIGN_IN_WEB_CLIENT_ID=

# Optional SERVER-ONLY hosted simulation. Leave blank for local emulator use.
# Use a separate synthetic-data project whose ID ends in -academic-demo.
# Never configure these in a real payment/clinical project or EXPO_PUBLIC values.
PAYMENT_SIMULATION_MODE=
PAYMENT_SIMULATION_PROJECT_ID=
