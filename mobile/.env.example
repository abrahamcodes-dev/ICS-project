EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Development Android Studio emulator ONLY. Fixed demo-calladoc project; live values above are ignored.
# Leave false for normal mode. Never enable in a release build. Fully reload when changing modes.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false

# Public OAuth client IDs (never a client secret). Android requires a WEB client
# ID plus an Android OAuth client for com.calladoc.app and the build's SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only; both values are required before an iOS development build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
